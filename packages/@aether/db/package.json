    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aether/types": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@aether/config": "workspace:*",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "typescript": "^6.0.0"

{
  "name": "@aether/db",
  "version": "0.0.1",
  "description": "Aether 数据层：Drizzle schema、迁移、查询封装、Realm 隔离守卫。字段命名遵循 Aether 术语。",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aether/types": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@aether/config": "workspace:*",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
